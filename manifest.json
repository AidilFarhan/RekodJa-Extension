{
  "manifest_version": 3,
  "name": "RekodJa: Job Tracker",
  "version": "1.4",
  "description": "RekodJa: Job Tracker records your job applications straight into your own Google Sheet.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "RekodJa",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "identity",
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://sheets.googleapis.com/*",
    "https://gmail.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "733030901679-lsqcm88g09vqev7afk2mrb8q5iermc0a.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets"
    ]
  },
  "background": {
    "service_worker": "gmail-background.js"
  },
  "minimum_chrome_version": "120"
}
